# Production .env — place at /var/www/contractorwebdev/.env
# NEVER commit this file. chmod 600 after creating.

DJANGO_SETTINGS_MODULE=config.settings.production

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-long-random-secret-key-here

# PostgreSQL local (sslmode=prefer works without SSL certs for localhost)
DATABASE_URL=postgresql://contractorwebdev:STRONG_DB_PASSWORD@localhost:5432/contractorwebdev?sslmode=prefer

# Comma-separated, no spaces, no trailing slash
ALLOWED_HOSTS=contractorwebdev.com,www.contractorwebdev.com

# OpenRouter AI
OPENROUTER_API_KEY=sk-or-v1-...

# Cloudflare Turnstile — get from dash.cloudflare.com → Turnstile → your site
CF_TURNSTILE_SITE_KEY=0x4AAAA...
CF_TURNSTILE_SECRET_KEY=0x4AAAA...

# Cal.com — get from cal.com → Settings → Developer → API Keys
CAL_API_KEY=cal_live_...
CAL_USERNAME=your-cal-username
CAL_SLUG_PLUMBING=plumbing-repair
CAL_SLUG_FAUCET=faucet-toilet
CAL_SLUG_ELECTRICAL=electrical-work
